# RiskTrace API
RISKTRACE_ENVIRONMENT=development
RISKTRACE_LOG_LEVEL=INFO
RISKTRACE_CORS_ORIGINS=http://localhost:3000
RISKTRACE_DATABASE_URL=postgresql+asyncpg://risktrace:risktrace-local@localhost:5432/risktrace
RISKTRACE_REDIS_URL=redis://localhost:6379/0
RISKTRACE_S3_ENDPOINT_URL=http://localhost:9000
RISKTRACE_S3_ACCESS_KEY_ID=risktrace
RISKTRACE_S3_SECRET_ACCESS_KEY=risktrace-local-secret
RISKTRACE_S3_BUCKET=risktrace
RISKTRACE_HEALTHCHECK_TIMEOUT_SECONDS=2
RISKTRACE_LLM_PROVIDER=openai
RISKTRACE_LLM_MODEL=gpt-4o-mini
RISKTRACE_LLM_SMALL_MODEL=gpt-4o-mini
RISKTRACE_LLM_API_KEY=sk-your-key-here
RISKTRACE_LLM_BASE_URL=
RISKTRACE_LLM_TEMPERATURE=0.3
RISKTRACE_LLM_MAX_TOKENS=2048

# Docker Compose infrastructure
POSTGRES_DB=risktrace
POSTGRES_USER=risktrace
POSTGRES_PASSWORD=risktrace-local
MINIO_ROOT_USER=risktrace
MINIO_ROOT_PASSWORD=risktrace-local-secret

# Next.js server-side API endpoint
RISKTRACE_API_URL=http://localhost:8000
